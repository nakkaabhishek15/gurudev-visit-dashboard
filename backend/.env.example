# Copy to backend/.env for local runs. Never commit the real file.
APP_ENV=local

# Local docker compose Postgres. In AWS this comes from Secrets Manager.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/gurudev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=local-dev-session-secret-change-me

# Leave false for plain-HTTP local dev. Terraform sets this true in AWS.
AUTH_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MAX_FAILED_LOGINS=10
LOCKOUT_MINUTES=15
