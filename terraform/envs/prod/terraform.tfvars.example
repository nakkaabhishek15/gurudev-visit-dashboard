# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# The four variables below have no defaults -- OpenTofu will not plan without them.

# Globally unique. Convention: <app>-frontend-<env>-<account-id>
frontend_bucket_name = "gurudev-frontend-prod-716156543359"

# Both optional. Leave them empty for the first deploy: CloudFront then serves the
# app on its own dxxxxxxxx.cloudfront.net name over HTTPS, so there is a working
# link to share before any DNS exists. `tofu output app_url` prints it.
#
# To add the custom domain later, request the certificate, point the hostname at
# the distribution, set both values, and re-apply.
#
# app_hostname = "site.devopsagent.com"
# MUST be issued in us-east-1, whatever region the rest of the stack uses.
# acm_certificate_arn = "arn:aws:acm:us-east-1:716156543359:certificate/REPLACE-ME"

# NOT just owner/repo. GitHub issues OIDC subjects with immutable numeric IDs
# appended to both the owner and the repo, so that renaming either cannot hand
# your AWS trust to whoever claims the old name. The role's trust policy must
# match that exact string; the plain owner/repo form is rejected with
# "Not authorized to perform sts:AssumeRoleWithWebIdentity".
#
# Find the two ids with:
#   curl -s https://api.github.com/repos/<owner>/<repo> | jq '.id, .owner.id'
#
# Format: <owner>@<owner_id>/<repo>@<repo_id>
github_repository = "nakkaabhishek15@318477587/gurudev-visit-dashboard@1340134155"

# --- Optional overrides -----------------------------------------------------

# app_name              = "gurudev"
# backend_desired_count = 1
# backend_task_cpu      = 256
# backend_task_memory   = 512

# Only set true if the GitHub OIDC provider does not already exist in the
# account. It does exist if aolf-warehouse has been applied. Creating a second
# one fails with EntityAlreadyExists.
# create_github_oidc_provider = false
